# ==============================================================================
# AI CITIZEN JOURNEY ENGINE - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
PROJECT_NAME="AI Citizen Journey Engine API"
VERSION="2.0.0"
DEBUG=true

# Database Configuration
DATABASE_URL="sqlite:///./citizen_journey.db"

# JWT Authentication Security
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev_super_secret_jwt_key_change_in_production_987654321"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 Days

# OTP Authentication Settings
# OTP_PROVIDER choices: "development", "msg91", "twilio"
OTP_PROVIDER="development"

# When DEV_OTP_MODE is true:
# 1. OTP is logged directly to the backend terminal stdout.
# 2. OTP is exposed in the API response payload under "dev_otp" for instant dev testing.
DEV_OTP_MODE=true

OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Production MSG91 OTP Configuration (Required if OTP_PROVIDER="msg91")
MSG91_WIDGET_ID="366872725377313536323534"
MSG91_AUTH_KEY=""
MSG91_TOKEN_AUTH=""
MSG91_TEMPLATE_ID=""


# Production Twilio OTP Configuration (Required if OTP_PROVIDER="twilio")
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
