# ==============================================================================
# AI CITIZEN JOURNEY ENGINE - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
PROJECT_NAME="AI Citizen Journey Engine API"
VERSION="2.0.0"
DEBUG=true

# Database Configuration
DATABASE_URL="sqlite:///./citizen_journey.db"

# JWT Authentication Security
# Generate a secure secret using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="dev_super_secret_jwt_key_change_in_production_987654321"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 Days

# Brute-Force and Cooldown Lockout Settings
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600 # 10 Minutes Lockout Duration

# Pre-defined Demo Citizen PIN Overrides (Optional - defaults to '000000' if not set)
CITIZEN_DEFAULT_PIN="000000"
CITIZEN_PIN_HRIDAY="000000"
CITIZEN_PIN_VARAD="000000"
CITIZEN_PIN_NARAYAN="000000"

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
